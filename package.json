{
  "name": "supabase-grants-lint",
  "version": "0.2.0",
  "description": "Replays Supabase SQL migrations and flags tables the Data API cannot reach once auto-grants are gone (PostgREST 42501).",
  "keywords": [
    "supabase",
    "postgres",
    "postgresql",
    "rls",
    "grants",
    "linter",
    "migrations",
    "security",
    "cli",
    "github-action"
  ],
  "homepage": "https://github.com/guptaaman678/supabase-grants-lint#readme",
  "bugs": {
    "url": "https://github.com/guptaaman678/supabase-grants-lint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guptaaman678/supabase-grants-lint.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aman Gupta",
    "url": "https://github.com/guptaaman678"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "supabase-grants-lint": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "schema/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mutation": "stryker run",
    "bench": "tsup && node scripts/bench.js",
    "pack-check": "tsup && node scripts/pack-install-check.js",
    "corpus": "tsup && node scripts/corpus-regression.js",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "libpg-query": "18.1.5",
    "postgres": "3.4.9"
  }
}
